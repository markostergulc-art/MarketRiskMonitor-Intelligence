{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketriskmonitor.local/schemas/alert.schema.json",
  "title": "MRM OSINT Alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alert_id",
    "type",
    "ref_id",
    "priority",
    "verification_score",
    "impact_severity",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "alert_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "EVENT",
        "SIGNAL",
        "RISK"
      ]
    },
    "ref_id": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "verification_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "impact_severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
