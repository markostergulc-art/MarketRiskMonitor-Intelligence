{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketriskmonitor.local/schemas/event.schema.json",
  "title": "MRM OSINT Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "revision",
    "lifecycle_status",
    "category",
    "subcategory",
    "event_time",
    "first_detected_at",
    "last_updated_at",
    "accuracy",
    "impact_severity",
    "geography",
    "entities",
    "commodities",
    "claims",
    "source_refs",
    "evidence_family_refs",
    "assessment",
    "translations",
    "revision_history",
    "ai_metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 8
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle_status": {
      "enum": [
        "DETECTED",
        "UNVERIFIED",
        "CORROBORATED",
        "VERIFIED",
        "RESOLVED",
        "DISPUTED",
        "RETRACTED",
        "STALE"
      ]
    },
    "category": {
      "enum": [
        "ENERGY",
        "SHIPPING_LOGISTICS",
        "GEOPOLITICS",
        "CRITICAL_MATERIALS",
        "FOOD_AGRICULTURE",
        "INDUSTRY",
        "INFRASTRUCTURE",
        "OTHER"
      ]
    },
    "subcategory": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "event_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_at",
        "end_at",
        "precision",
        "date"
      ],
      "properties": {
        "start_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "precision": {
          "enum": [
            "EXACT",
            "APPROXIMATE",
            "DATE_ONLY",
            "UNKNOWN"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "first_detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "label",
        "confidence",
        "independent_evidence_families",
        "material_contradiction",
        "reasoning_summary"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "label": {
          "enum": [
            "UNVERIFIED",
            "PLAUSIBLE",
            "CORROBORATED",
            "STRONGLY_VERIFIED",
            "VERIFIED"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "independent_evidence_families": {
          "type": "integer",
          "minimum": 0
        },
        "material_contradiction": {
          "type": "boolean"
        },
        "reasoning_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "impact_severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countries",
        "regions",
        "locations"
      ],
      "properties": {
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "country",
              "lat",
              "lon",
              "precision"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "country": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z]{2}$"
              },
              "lat": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -180,
                "maximum": 180
              },
              "precision": {
                "enum": [
                  "EXACT",
                  "CITY",
                  "REGION",
                  "COUNTRY",
                  "UNKNOWN"
                ]
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companies",
        "organizations",
        "infrastructure",
        "people"
      ],
      "properties": {
        "companies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "organizations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "commodities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "type",
          "text_en",
          "verification_status",
          "source_refs",
          "evidence_family_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 4
          },
          "type": {
            "enum": [
              "FACT",
              "SOURCE_CLAIM",
              "AI_INFERENCE"
            ]
          },
          "text_en": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "enum": [
              "UNVERIFIED",
              "PLAUSIBLE",
              "CORROBORATED",
              "VERIFIED",
              "DISPUTED",
              "INFERENCE"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence_family_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_family_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eu_relevance",
        "germany_relevance",
        "observed_impacts",
        "potential_impacts",
        "shortage_signal",
        "shortage_state",
        "time_horizon",
        "uncertainties"
      ],
      "properties": {
        "eu_relevance": {
          "enum": [
            "NONE",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "germany_relevance": {
          "enum": [
            "NONE",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "observed_impacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "potential_impacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shortage_signal": {
          "type": "boolean"
        },
        "shortage_state": {
          "enum": [
            "NONE",
            "RISK",
            "CURRENT"
          ]
        },
        "time_horizon": {
          "enum": [
            "HOURS",
            "DAYS",
            "DAYS_TO_WEEKS",
            "WEEKS_TO_MONTHS",
            "MONTHS_PLUS",
            "UNKNOWN"
          ]
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hr",
        "de",
        "fr",
        "es"
      ],
      "properties": {
        "en": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "summary",
            "why_it_matters",
            "observed_impact",
            "potential_impact",
            "uncertainties"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "why_it_matters": {
              "type": "string"
            },
            "observed_impact": {
              "type": "string"
            },
            "potential_impact": {
              "type": "string"
            },
            "uncertainties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "hr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "summary",
            "why_it_matters",
            "observed_impact",
            "potential_impact",
            "uncertainties"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "why_it_matters": {
              "type": "string"
            },
            "observed_impact": {
              "type": "string"
            },
            "potential_impact": {
              "type": "string"
            },
            "uncertainties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "de": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "summary",
            "why_it_matters",
            "observed_impact",
            "potential_impact",
            "uncertainties"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "why_it_matters": {
              "type": "string"
            },
            "observed_impact": {
              "type": "string"
            },
            "potential_impact": {
              "type": "string"
            },
            "uncertainties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "fr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "summary",
            "why_it_matters",
            "observed_impact",
            "potential_impact",
            "uncertainties"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "why_it_matters": {
              "type": "string"
            },
            "observed_impact": {
              "type": "string"
            },
            "potential_impact": {
              "type": "string"
            },
            "uncertainties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "es": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "summary",
            "why_it_matters",
            "observed_impact",
            "potential_impact",
            "uncertainties"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "why_it_matters": {
              "type": "string"
            },
            "observed_impact": {
              "type": "string"
            },
            "potential_impact": {
              "type": "string"
            },
            "uncertainties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "changed_at",
          "previous_score",
          "new_score",
          "previous_status",
          "new_status",
          "reason"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "previous_score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "new_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "previous_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "new_status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "ai_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_run_id",
        "generated_at",
        "pipeline_version",
        "canonical_language",
        "model_label"
      ],
      "properties": {
        "research_run_id": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "pipeline_version": {
          "type": "string"
        },
        "canonical_language": {
          "const": "en"
        },
        "model_label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
